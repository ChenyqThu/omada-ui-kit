{
  "name": "@chenyqthu/omada-ui-kit",
  "version": "0.7.0",
  "description": "Omada Controller v6.3 React UI component library (Ant Design 6 + Design Tokens + Figma Assets + Single-file HTML standalone bundle)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyqThu/omada-ui-kit.git"
  },
  "homepage": "https://github.com/ChenyqThu/omada-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/ChenyqThu/omada-ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/lib/core.d.ts",
      "import": "./dist/core.js"
    },
    "./blocks": {
      "types": "./dist/types/lib/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./charts": {
      "types": "./dist/types/lib/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./emulator": {
      "types": "./dist/types/lib/emulator.d.ts",
      "import": "./dist/emulator.js"
    },
    "./assets": {
      "types": "./dist/types/lib/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./agent": {
      "types": "./dist/types/lib/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./style.css": "./dist/style.css",
    "./style.scoped.css": "./dist/style.scoped.css",
    "./standalone": "./dist/standalone.js",
    "./catalog.json": "./dist/catalog.json",
    "./llms.txt": "./dist/llms.txt"
  },
  "files": [
    "dist",
    "skills/omada-ui-kit",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib",
    "build:app": "vite build --outDir dist-app",
    "build:pages": "VITE_BASE_PATH=/omada-ui-kit/ vite build --outDir dist-app",
    "build:esm": "vite build -c vite.lib.config.ts",
    "build:standalone": "vite build -c vite.standalone.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:catalog": "node scripts/generate-catalog.mjs",
    "build:lib": "pnpm build:esm && pnpm build:standalone && pnpm build:types && pnpm build:catalog",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.templates.json",
    "sync:local-skill": "node scripts/sync-local-skill.mjs",
    "test": "vitest run",
    "test:agent-eval": "node scripts/eval-agent-readiness.mjs",
    "test:agent-bench": "node scripts/benchmark-agent-bridge.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@fontsource/manrope": "^5.2.5",
    "antd": "^6.7.1",
    "echarts": "^5.6.0",
    "lucide-react": "^1.77.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
